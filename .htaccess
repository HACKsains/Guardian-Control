# ==============================================================================
# GUARDIAN CONTROL — PRODUCTION & LOCAL .HTACCESS (guardian-dome.ilmuna.my.id)
# Kompatibel LiteSpeed / Apache / cPanel (PHP ea-php74 s/d 8.3+)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GUARDIAN DOME — LAYER PERLINDUNGAN TERDEPAN (guardian-dome.ilmuna.my.id)
# ------------------------------------------------------------------------------
<IfModule lsapi_module>
   php_value auto_prepend_file "/home/uofruaju/guardian-dome/guardian-dome-waf.php"
   php_value error_log "/home/uofruaju/logs/php.error.log"
   php_flag log_errors On
   php_flag display_errors Off
   php_value max_execution_time 300
   php_value max_input_time 600
   php_value max_input_vars 1000
   php_value memory_limit 256M
   php_value post_max_size 128M
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>

<IfModule php7_module>
   php_value auto_prepend_file "/home/uofruaju/guardian-dome/guardian-dome-waf.php"
   php_value error_log "/home/uofruaju/logs/php.error.log"
   php_flag log_errors On
   php_flag display_errors Off
   php_value max_execution_time 300
   php_value max_input_time 600
   php_value max_input_vars 1000
   php_value memory_limit 256M
   php_value post_max_size 128M
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>

<IfModule php8_module>
   php_value auto_prepend_file "/home/uofruaju/guardian-dome/guardian-dome-waf.php"
   php_value error_log "/home/uofruaju/logs/php.error.log"
   php_flag log_errors On
   php_flag display_errors Off
   php_value max_execution_time 300
   php_value max_input_time 600
   php_value max_input_vars 1000
   php_value memory_limit 256M
   php_value post_max_size 128M
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>

# Pengecualian auto_prepend_file pada endpoint OAuth2 callback, Global SLO & GitHub deploy webhook
<FilesMatch "^(sso-callback|sso-logout-webhook|logout|deploy)\.php$">
    <IfModule lsapi_module>
        php_value auto_prepend_file none
    </IfModule>
    <IfModule php7_module>
        php_value auto_prepend_file none
    </IfModule>
    <IfModule php8_module>
        php_value auto_prepend_file none
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. KEAMANAN TINGKAT SERVER (Headers, File Sensitif, XML-RPC, Directory Browsing)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Matikan Directory Browsing (Mencegah intip folder)
Options -Indexes

# Blokir Akses ke File Konfigurasi & Berkas Rahasia
<FilesMatch "^.*(((?:wp-config)\.(?:php|bak|swp))|\.env|\.sqlite|\.git|\.user\.ini|php\.ini|config\.local\.php|config\.local\.example\.php|\.[hH][tT][aApP].*|((?:error_log|readme|blueprint|implementation_plan|license|changelog|-config|-sample)\.(?:php|md|log|txt|htm|html)))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir Akses XML-RPC (Anti-Brute Force Amplification Attack)
<Files xmlrpc.php>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Blokir Akses Langsung ke Berkas .ht*
<FilesMatch ^(?i:\.ht.*)$>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 3. KOMPRESI GZIP, BROWSER CACHING ASET STATIS & LITESPEED NOABORT
# ------------------------------------------------------------------------------
FileETag None
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE font/opentype font/otf font/ttf font/woff font/woff2
    AddOutputFilterByType DEFLATE text/js text/css text/html text/javascript text/plain text/xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf application/font-woff2
    AddOutputFilterByType DEFLATE application/xhtml+xml application/xml application/rss+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresDefault A0
    ExpiresByType text/css A31536000
    ExpiresByType text/javascript A31536000
    ExpiresByType application/javascript A31536000
    ExpiresByType font/ttf A31536000
    ExpiresByType font/otf A31536000
    ExpiresByType font/woff A31536000
    ExpiresByType font/woff2 A31536000
    ExpiresByType image/jpg A31536000
    ExpiresByType image/jpeg A31536000
    ExpiresByType image/png A31536000
    ExpiresByType image/gif A31536000
    ExpiresByType image/webp A31536000
    ExpiresByType image/x-icon A31536000
    ExpiresByType image/svg+xml A31536000
</IfModule>

<IfModule Litespeed>
    SetEnv noabort 1
</IfModule>

# ------------------------------------------------------------------------------
# 4. CLEAN URLS & PROTEKSI DIREKTORI INTERNAL
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses HTTP langsung ke folder cron/, cache/, sdk/, includes/
    RewriteRule ^(cron|cache|sdk|includes)/ - [F,L]

    # Passthrough Authorization header
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Jangan rewrite jika file atau folder fisik ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URL tanpa .php (/dashboard, /login, /logout, /sso-callback, /sso-logout-webhook)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>
